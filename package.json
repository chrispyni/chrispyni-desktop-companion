{
  "name": "project-wives",
  "productName": "Project Wives",
  "version": "0.1.3-alpha",
  "description": "Desktop companions: Nixie & Noct, elf queens of ChrispyNi",
  "main": "src/main.js",
  "author": "ChrispyNi",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/",
    "sprites": "python3 tools/gen_sprites.py",
    "set-passphrase": "node tools/set-passphrase.js",
    "dist:win": "node tools/make-manifest.js && electron-builder --win 7z zip --x64",
    "dist:win-installer": "electron-builder --win nsis --x64",
    "predist:win": "node tools/make-manifest.js"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "pe-library": "^2.0.1",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "com.chrispyni.projectwives",
    "productName": "Project Wives",
    "files": [
      "src/**",
      "package.json"
    ],
    "win": {
      "target": [
        "7z",
        "zip"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "src/win-awareness.ps1"
    ],
    "extraFiles": [
      {
        "from": "content",
        "to": "content"
      },
      {
        "from": "mods",
        "to": "mods"
      },
      {
        "from": "plugins",
        "to": "plugins"
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "config.example.json",
        "to": "config.example.json"
      },
      {
        "from": "version.json",
        "to": "version.json"
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "SPRITES.md",
        "to": "SPRITES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "build/folder-readme.txt",
        "to": "READ ME FIRST.txt"
      },
      {
        "from": "content-manifest.json",
        "to": "content-manifest.json"
      }
    ],
    "artifactName": "ProjectWives-${version}-win.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ProjectWives-${version}-setup.${ext}",
      "shortcutName": "Project Wives",
      "createDesktopShortcut": true,
      "include": "build/installer.nsh"
    },
    "afterPack": "build/afterPack.js",
    "extraMetadata": {}
  }
}